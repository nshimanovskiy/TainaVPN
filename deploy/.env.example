# Имя, которое увидят пользователи в приложении
TVPN_NAME=Tainavpn
# Домен или IP VPS, к которому подключаются клиенты по SOCKS5
TVPN_PUBLIC_HOST=vpn.sdsds.top
# Порт SOCKS5 (должен быть свободен на VPS)
TVPN_SOCKS_PORT=1080
# Внешний адрес API (через nginx). По нему приложение получает прокси
TVPN_PUBLIC_URL=https://vpn.sdsds.top
# API слушает только localhost, nginx проксирует на него
TVPN_API_LISTEN=127.0.0.1:8090
# Токен для входа в админ-панель (минимум 16 символов): openssl rand -hex 24
TVPN_ADMIN_TOKEN=CHANGE_ME
# Путь админ-панели
TVPN_ADMIN_PATH=/panel
# true — приложение может само получить личный ключ кнопкой «Получить с сервера»
TVPN_OPEN_REGISTRATION=true
# Сколько ключей в сутки может получить один IP через приложение
TVPN_REGISTER_PER_DAY=3
