# Имя, которое увидят пользователи в приложении
TVPN_NAME=Tainavpn
# Внешний адрес API (через nginx). По нему приложение получает прокси
TVPN_PUBLIC_URL=https://vpn.sdsds.top
# API слушает только localhost, nginx проксирует на него
TVPN_API_LISTEN=127.0.0.1:8090
# Токен для входа в админ-панель (минимум 16 символов): openssl rand -hex 24
TVPN_ADMIN_TOKEN=CHANGE_ME
# Путь админ-панели
TVPN_ADMIN_PATH=/adminadminadmin

# --- Telegram-бот ---
# Токен бота от @BotFather (пусто — бот не запускается)
TVPN_BOT_TOKEN=
# Общий секрет бота и сервера (создаётся автоматически при деплое)
TVPN_BOT_SECRET=CHANGE_ME
# Кому бот выдаёт ссылки: Telegram ID или @username через запятую. Пусто — всем.
TVPN_BOT_ALLOWED=
# Кнопка «Купить свои прокси» в меню бота (реферальная ссылка). «-» — скрыть кнопку.
TVPN_BOT_PARTNER_URL=https://t.me/SteelProxyBot?start=r_43172017
